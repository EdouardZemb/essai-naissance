# Rendu de deploiement/systemd/essai-naissance-sauvegarde.service.in par deploiement/installer-unites.sh.
# Ne pas modifier à la main : la sonde de prod alerte au moindre écart avec ce rendu.
[Unit]
Description=essai-naissance : sauvegarde de la base (@ENV@)
OnFailure=essai-naissance-alerte@%n.service

[Service]
Type=oneshot
ExecStart=/bin/bash @CLONE@/deploiement/sauvegarder.sh @ENV@
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min
