# Rendu de deploiement/systemd/essai-naissance-sonde.timer.in par deploiement/installer-unites.sh.
# Ne pas modifier à la main : la sonde de prod alerte au moindre écart avec ce rendu.
[Unit]
Description=essai-naissance : minuterie de la sonde (@ENV@)

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
